<ui:FluentWindow x:Class="FluentWpfSample.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Fluent Dashboard"
                 Width="1180"
                 Height="760"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource AppBackgroundBrush}">

    <ui:FluentWindow.Resources>

        <!-- Local Brushes -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AFAFAF" />
        <SolidColorBrush x:Key="PanelSecondaryBrush" Color="#333333" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />

        <!-- Card Style -->
        <Style x:Key="FluentCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="150" />
        </Style>

        <!-- Panel Style -->
        <Style x:Key="FluentPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="22" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0"
                     Title="Fluent Dashboard"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Margin="16,12,8,16"
                    CornerRadius="18"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1">

                <StackPanel Margin="16">

                    <TextBlock Text="Menu"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="8,0,0,12" />

                    <ui:Button Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,0,8"
                               Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" />
                            <TextBlock Text="Dashboard" Margin="12,0,0,0" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,0,8"
                               Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DataHistogram24" />
                            <TextBlock Text="Analytics" Margin="12,0,0,0" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,0,8"
                               Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" />
                            <TextBlock Text="Settings" Margin="12,0,0,0" />
                        </StackPanel>
                    </ui:Button>

                    <Separator Margin="0,16" />

                    <TextBlock Text="Status"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="8,0,0,12" />

                    <Border CornerRadius="14"
                            Padding="14"
                            Background="{StaticResource PanelSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="System Online"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="All services are running"
                                       FontSize="12"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12,24,24">

                    <!-- Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Dashboard"
                                       FontSize="34"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="今日の状態をざっくり確認できます"
                                       FontSize="14"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <ui:TextBox Grid.Column="1"
                                    PlaceholderText="Search..."
                                    Height="42"
                                    Margin="0,8,0,0" />
                    </Grid>

                    <!-- KPI Cards -->
                    <UniformGrid Columns="4" Margin="0,0,0,20">

                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="People24"
                                               FontSize="28"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,14" />
                                <TextBlock Text="Users"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="12,840"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="+12.5% this month"
                                           FontSize="12"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Cart24"
                                               FontSize="28"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,14" />
                                <TextBlock Text="Orders"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="1,284"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="+8.2% this week"
                                           FontSize="12"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Money24"
                                               FontSize="28"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,14" />
                                <TextBlock Text="Revenue"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="¥4.8M"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="+18.9% this month"
                                           FontSize="12"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCardStyle}">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="ArrowTrending24"
                                               FontSize="28"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,14" />
                                <TextBlock Text="Growth"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="32.4%"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="Stable performance"
                                           FontSize="12"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- Content Area -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource FluentPanelStyle}"
                                Margin="0,0,10,0">

                            <StackPanel>
                                <TextBlock Text="Recent Activity"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,16" />

                                <ListView BorderThickness="0"
                                          Background="Transparent">

                                    <ListViewItem Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                                           FontSize="24"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="注文処理が完了しました"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="Order #10482 has been completed"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="2 min ago"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Grid>
                                    </ListViewItem>

                                    <ListViewItem Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:SymbolIcon Symbol="PersonAdd24"
                                                           FontSize="24"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="新しいユーザーが登録されました"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="mika@example.com joined your workspace"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="18 min ago"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Grid>
                                    </ListViewItem>

                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource FluentPanelStyle}"
                                Margin="10,0,0,0">

                            <StackPanel>
                                <TextBlock Text="Quick Actions"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,16" />

                                <ui:Button Appearance="Primary"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,0,0,10"
                                           Padding="14">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" />
                                        <TextBlock Text="New Order" Margin="10,0,0,0" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="Secondary"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,0,0,10"
                                           Padding="14">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Document24" />
                                        <TextBlock Text="Export Report" Margin="10,0,0,0" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="Secondary"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,0,0,20"
                                           Padding="14">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Settings24" />
                                        <TextBlock Text="Open Settings" Margin="10,0,0,0" />
                                    </StackPanel>
                                </ui:Button>

                                <Border CornerRadius="16"
                                        Padding="16"
                                        Background="{StaticResource PanelSecondaryBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Design Tip"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="余白・角丸・薄い境界線だけでWPF感はかなり消せます。"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Margin="0,8,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>